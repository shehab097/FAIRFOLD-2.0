# ---------------------------------------------------------------------------
# FairFold environment. Copy to .env and fill in your values. Never commit .env.
# The backend loads this file via spring-dotenv (searches from the repo root).
# ---------------------------------------------------------------------------

# --- Database (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fairfold
DB_USER=fairfold
DB_PASSWORD=

# --- Auth ---
# At least 32 bytes. Generate with: openssl rand -hex 48
JWT_SECRET=

# --- Files (relative to the directory where the backend runs, i.e. backend/) ---
STORAGE_DIR=../data/resumes

# --- Admin seed account (created by the seed script on first run) ---
ADMIN_EMAIL=admin@fairfold.local
ADMIN_PASSWORD=

# --- AI (chunk 2; fallback needs no key) ---
AI_PROVIDER=fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_PRICE_INPUT_PER_M=
AI_PRICE_OUTPUT_PER_M=

# --- Payments (chunk 5; fake needs no credentials) ---
PAYMENT_PROVIDER=fake
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
APP_BASE_URL=http://localhost:5173
