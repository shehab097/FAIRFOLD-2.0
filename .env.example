# ---------------------------------------------------------------------------
# FairFold environment. Copy to .env and fill in your values. Never commit .env.
# The backend loads this file via spring-dotenv (searches from the repo root).
# ---------------------------------------------------------------------------

# --- Database (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fairfold
DB_USER=fairfold
DB_PASSWORD=
# Only used by the MariaDB container in Docker (chunk 6); the app never reads it.
# DB_ROOT_PASSWORD=

# --- Auth ---
# At least 32 bytes. Generate with: openssl rand -hex 48
JWT_SECRET=

# --- Files (relative to the directory where the backend runs, i.e. backend/) ---
STORAGE_DIR=../data/resumes

# --- Admin seed account (created by the seed script on first run) ---
ADMIN_EMAIL=admin@fairfold.local
ADMIN_PASSWORD=

# --- AI (chunk 2; fallback needs no key) ---
AI_PROVIDER=fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Reasoning models can spend tokens on hidden reasoning before the JSON answer.
AI_MAX_TOKENS=4000
AI_PRICE_INPUT_PER_M=0.30
AI_PRICE_OUTPUT_PER_M=1.20

# --- Assessments and resources (chunk 3) ---
# Failed attempts can be retaken after this many hours (default 48;
# application-local.yml sets 0 for the local demo).
ASSESSMENT_COOLDOWN_HOURS=48
# Team invite link lifetime (default 7 days).
INVITE_VALID_DAYS=7
# Weekly learning-resource link check (Spring cron; default Sunday 03:00).
# RESOURCE_LINK_CHECK_CRON=0 0 3 * * SUN

# --- Payments (chunk 5; fake needs no credentials) ---
PAYMENT_PROVIDER=fake
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
APP_BASE_URL=http://localhost:5173
